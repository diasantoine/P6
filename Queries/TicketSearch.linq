<Query Kind="Statements">
  <Connection>
    <Server>localhost</Server>
    <Database>NexaWorks</Database>
    <DriverData>
      <TrustServerCertificate>true</TrustServerCertificate>
    </DriverData>
  </Connection>
</Query>

// Ticket search for NexaWorks.
// One parameterized query instead of one query per case: in progress / resolved, for a product,
// a version, a period and keywords are all the same query with different criteria.
// Each call below is one request; open the "SQL" tab to see the single SELECT sent to SQL Server.

const int InProgress = 1;
const int Resolved = 2;

// --- In progress tickets ---
Search(InProgress).Dump("In progress - all products");
Search(InProgress, product: "Trader en Herbe").Dump("In progress - one product");
Search(InProgress, product: "Trader en Herbe", version: "1.3").Dump("In progress - one product, one version");
Search(InProgress, from: new DateTime(2024, 1, 1), to: new DateTime(2024, 12, 31)).Dump("In progress - all products, period");
Search(InProgress, product: "Trader en Herbe", from: new DateTime(2024, 1, 1), to: new DateTime(2024, 12, 31)).Dump("In progress - one product, period");
Search(InProgress, keywords: new[] { "écran" }).Dump("In progress - all products, keywords");
Search(InProgress, keywords: new[] { "utilisateur", "écran" }).Dump("In progress - all products, several keywords");
Search(InProgress, product: "Trader en Herbe", version: "1.3", keywords: new[] { "euro" }).Dump("In progress - one product, one version, keywords");

// --- Resolved tickets ---
Search(Resolved).Dump("Resolved - all products");
Search(Resolved, product: "Trader en Herbe").Dump("Resolved - one product");
Search(Resolved, product: "Trader en Herbe", version: "1.2").Dump("Resolved - one product, one version");
Search(Resolved, from: new DateTime(2023, 1, 1), to: new DateTime(2023, 12, 31)).Dump("Resolved - all products, period");

// The only query. Status is required; every other criterion is added only when it is filled.
// Nothing is sent to the database while the query is built: it runs once, when Dump() reads it.
IQueryable<object> Search(
    int status,
    string product = null,
    string version = null,
    DateTime? from = null,  // period start (inclusive), on the creation date
    DateTime? to = null,    // period end (inclusive), on the creation date
    string[] keywords = null)  // words that must all appear in the problem description
{
    var query = Tickets.Where(t => t.StatusId == status);

    if (!string.IsNullOrWhiteSpace(product))
    {
        query = query.Where(t => t.VersionOperatingSystem.Version.Product.Name == product);
    }

    if (!string.IsNullOrWhiteSpace(version))
    {
        query = query.Where(t => t.VersionOperatingSystem.Version.Number == version);
    }

    if (from is not null)
    {
        query = query.Where(t => t.CreatedAt >= from.Value);
    }

    if (to is not null)
    {
        query = query.Where(t => t.CreatedAt <= to.Value);
    }

    // One Where per keyword: the ticket must contain all of them (translated to LIKE '%word%').
    foreach (var keyword in keywords ?? Array.Empty<string>())
    {
        query = query.Where(t => t.Problem.Contains(keyword));
    }

    // Projection: only the needed columns are read, the joins are generated by LINQ.
    return query
        .OrderBy(t => t.CreatedAt)
        .Select(t => new
        {
            t.Id,
            Product = t.VersionOperatingSystem.Version.Product.Name,
            Version = t.VersionOperatingSystem.Version.Number,
            OperatingSystem = t.VersionOperatingSystem.OperatingSystem.Name,
            Status = t.Status.Label,
            t.CreatedAt,
            t.ResolvedAt,
            t.Problem,
            t.Resolution
        });
}
